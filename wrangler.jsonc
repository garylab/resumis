{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resumis-cf",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "vars": {
    "GITHUB_CLIENT_ID": "",
    "PUBLIC_ORIGIN": "",
    "SITE_NAME": "Resumis",
    "GA_MEASUREMENT_ID": "",
    "PRIVACY_POLICY_CONTENT": "",
    "TERMS_OF_SERVICE_CONTENT": "",
    "FOOTER_CONTENT": ""
  },
  "dev": {
    "ip": "0.0.0.0",
    "port": 8988,
    "local_protocol": "http"
  },
  "build": {
    "command": "npm run build",
    "watch_dir": ["templates", "data", "scripts"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true }
}
